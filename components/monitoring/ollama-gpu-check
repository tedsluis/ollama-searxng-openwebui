#!/usr/bin/bash
# Fails when a loaded model is not sufficiently on the GPU.
# Does not load a model itself: without a loaded model there is nothing to check.
set -euo pipefail
: "${OLLAMA_URL:?}"
min=${MIN_GPU_PERCENT:-40}

ps_json=$(curl -fsS -m 10 "${OLLAMA_URL}/api/ps")
rows=$(jq -r '(.models // [])[] | select((.size // 0) > 0)
              | [.name, .size, (.size_vram // 0)] | @tsv' <<<"$ps_json")

if [ -z "$rows" ]; then
  echo "no local model loaded; GPU split not checked"
  exit 0
fi

rc=0
while IFS=$'\t' read -r name size vram; do
  pct=$(( vram * 100 / size ))
  echo "${name}: ${pct}% on the GPU (threshold ${min}%)"
  if [ "$pct" -lt "$min" ]; then
    echo "ERROR: ${name} runs ${pct}% on the GPU" >&2
    rc=1
  fi
done <<<"$rows"
exit "$rc"
