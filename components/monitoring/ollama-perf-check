#!/usr/bin/bash
# Measures tokens/s with a fixed model and fails below the threshold.
# The first call loads the model and warms up; only the second one counts.
set -euo pipefail
: "${OLLAMA_URL:?}" "${PERF_MODEL:?}" "${PERF_MIN_TPS:?}"

gen() {  # gen <keep_alive as JSON>
  curl -fsS -m 600 "${OLLAMA_URL}/api/generate" -d "$(jq -n \
    --arg m "$PERF_MODEL" --argjson k "$1" \
    '{model: $m, stream: false, keep_alive: $k,
      prompt: "Write the numbers from one to sixty as English words.",
      options: {num_predict: 96, temperature: 0, seed: 1}}')"
}

gen '"5m"' >/dev/null
resp=$(gen 0)
tps=$(jq -r 'if (.eval_duration // 0) > 0
             then (.eval_count / .eval_duration * 1e9 * 10 | round / 10)
             else 0 end' <<<"$resp")

echo "${PERF_MODEL}: ${tps} t/s (threshold ${PERF_MIN_TPS} t/s)"
if ! jq -en --argjson t "$tps" --argjson m "$PERF_MIN_TPS" '$t >= $m' >/dev/null; then
  echo "ERROR: ${PERF_MODEL} reaches ${tps} t/s" >&2
  exit 1
fi
