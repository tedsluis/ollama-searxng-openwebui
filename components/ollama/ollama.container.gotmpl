[Unit]
Description=Ollama LLM Server (Quadlet via Materia)
After=network-online.target nvidia-persistenced.service
Wants=network-online.target

[Container]
Image=docker.io/ollama/ollama:{{ .containerTag }}
ContainerName=ollama
Network=host
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
Volume={{ .modelsPath }}:/root/.ollama:Z
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=CUDA_VISIBLE_DEVICES=0
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_GPU_OVERHEAD={{ .gpuOverhead }}
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE={{ .keepAlive }}
PodmanArgs=--cpuset-cpus={{ .cpuPinList }}
HealthCmd=/bin/ollama list || exit 1
HealthInterval=15s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill
Notify=healthy

[Service]
TimeoutStartSec=900
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target default.target
