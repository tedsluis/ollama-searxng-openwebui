[Unit]
Description=Ollama LLM Server (Quadlet via Materia)
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service
OnFailure=notify-failure@%n.service

[Container]
Image=docker.io/ollama/ollama:{{ .containerTag }}
ContainerName=ollama
Network=host
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
Volume={{ .modelsPath }}:/root/.ollama:Z
Environment=OLLAMA_HOST=127.0.0.1:{{ .ollamaPort }}
Environment=CUDA_VISIBLE_DEVICES=0
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_GPU_OVERHEAD={{ .gpuOverhead }}
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE={{ .keepAlive }}
Environment=OLLAMA_CONTEXT_LENGTH={{ .contextLength }}
Environment=OLLAMA_KV_CACHE_TYPE={{ .kvCacheType }}
PodmanArgs=--cpuset-cpus={{ .cpuPinList }}
HealthCmd=/bin/ollama list || exit 1
HealthInterval=15s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill
Notify=healthy

[Service]
# Regenerate the CDI spec on every start so it always matches the installed NVIDIA libraries
ExecStartPre=/usr/bin/mkdir -p /run/cdi
ExecStartPre=nvidia-ctk cdi generate --output=/run/cdi/nvidia.yaml
TimeoutStartSec=900
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=5min

[Install]
WantedBy=multi-user.target default.target
