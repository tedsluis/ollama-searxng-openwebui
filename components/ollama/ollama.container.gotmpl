[Unit]
Description=Ollama LLM Server (Quadlet via Materia)
After=network-online.target nvidia-persistenced.service
Wants=network-online.target

[Container]
Image=docker.io/ollama/ollama:{{ .containerTag }}
ContainerName=ollama
Network=host

# Geef de NVIDIA RTX A2000 12GB door via CDI en schakel SELinux-isolatie uit voor /dev/nvidia*
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true

# Koppel je bestaande modellenmap zodat je niets opnieuw hoeft te downloaden
Volume={{ .modelsPath }}:/root/.ollama:Z

# Onze bewezen optimalisaties voor de 12GB RTX A2000
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=CUDA_VISIBLE_DEVICES=0
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_GPU_OVERHEAD={{ .gpuOverhead }}
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_KEEP_ALIVE={{ .keepAlive }}

# Vervangt het oude ollama-taskset-wrapper script: pin op de 14 fysieke cores (6P + 8E)
PodmanArgs=--cpuset-cpus={{ .cpuPinList }}

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target default.target
