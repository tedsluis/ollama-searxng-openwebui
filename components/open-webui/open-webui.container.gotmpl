[Unit]
Description=Open WebUI (Quadlet via Materia)
After=network-online.target ollama.service searxng.service
Wants=network-online.target ollama.service searxng.service
OnFailure=notify-failure@%n.service

[Container]
Image=ghcr.io/open-webui/open-webui:{{ .containerTag }}
ContainerName=open-webui
Network=host
UserNS=keep-id
Volume={{ .dataPath }}:/app/backend/data:Z
EnvironmentFile={{ m_dataDir "open-webui" }}/open-webui.env
Secret=openwebui_openai_api_key,type=env,target=OPENAI_API_KEY
HealthCmd=curl -fsS http://127.0.0.1:{{ .openwebuiPort }}/health || exit 1
HealthInterval=15s
HealthRetries=3
HealthStartPeriod=60s
HealthOnFailure=kill
Notify=healthy

[Service]
ExecStartPre=-/usr/bin/cp -a /opt/open-webui/webui.db /opt/open-webui/webui.db.pre-update.bak
TimeoutStartSec=300
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=5min

[Install]
WantedBy=multi-user.target default.target

