PORT={{ .port }}
WEBUI_URL=http://127.0.0.1:{{ .port }}
ENABLE_PERSISTENT_CONFIG=False
MODELS_CACHE_TTL=300

# Connecties op localhost
OLLAMA_BASE_URL=http://127.0.0.1:11434
ENABLE_OPENAI_API=True
OPENAI_API_BASE_URL=http://127.0.0.1:8111/v1
OPENAI_API_KEY=replace-me-if-required

# SearXNG Integratie
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://127.0.0.1:8112/search?q=<query>

# Geen onnodige GPU-taken achteraf
ENABLE_FOLLOW_UP_GENERATION=False
ENABLE_TAGS_GENERATION=False
