[Unit]
Description=Renovate Dependency Update Runner (Quadlet via Materia)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/renovatebot/renovate:{{ .containerTag }}
ContainerName=renovate
EnvironmentFile=/etc/materia/renovate.env
Environment=RENOVATE_PLATFORM=github
Environment=RENOVATE_REPOSITORIES={{ .githubRepo }}
Environment=RENOVATE_GIT_AUTHOR=Renovate Bot <renovate@fedora.local>
Environment=LOG_LEVEL=info

[Service]
Type=oneshot
TimeoutStartSec=600
