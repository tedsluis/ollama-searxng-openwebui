[Unit]
Description=SearXNG Metasearch Engine (Quadlet via Materia)
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Container]
Image=docker.io/searxng/searxng:{{ .containerTag }}
ContainerName=searxng
PublishPort=127.0.0.1:{{ .searxngPort }}:8080
Volume={{ m_dataDir "searxng" }}/settings.yml:/etc/searxng/settings.yml:ro,Z
Volume={{ m_dataDir "searxng" }}/limiter.toml:/etc/searxng/limiter.toml:ro,Z
Volume=searxng-cache:/var/cache/searxng
Environment=SEARXNG_BASE_URL=http://127.0.0.1:{{ .searxngPort }}/
Secret=searxng_secret,type=env,target=SEARXNG_SECRET
HealthCmd=wget -q --spider http://127.0.0.1:8080/healthz || exit 1
HealthInterval=15s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill
Notify=healthy

[Service]
TimeoutStartSec=300
Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=5min

[Install]
WantedBy=multi-user.target default.target
