{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Amsterdam",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update containerTag variables in Materia vault.toml",
      "managerFilePatterns": [
        "/^attributes/vault\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\ncontainerTag\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "ignoreTests": true
    },
    {
      "description": "Docker Hub provides release timestamps: wait 3 days for hotfix releases (ghcr.io cannot be aged)",
      "matchDepNames": ["docker.io/ollama/ollama", "docker.io/searxng/searxng"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Ollama: a minor bump on 0.x is breaking, review manually",
      "matchDepNames": ["docker.io/ollama/ollama"],
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false
    },
    {
      "description": "Open WebUI breaks in patch releases too (DB migrations, removed env vars), always review manually",
      "matchDepNames": ["ghcr.io/open-webui/open-webui"],
      "automerge": false
    },
    {
      "description": "SearXNG publishes several builds per day: update at most once a week",
      "matchDepNames": ["docker.io/searxng/searxng"],
      "schedule": ["* 0-6 * * 1"]
    }
  ]
}
